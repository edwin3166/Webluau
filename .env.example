# Local development only. On Render, set these in the service Environment settings.
PORT=3000
ALLOWED_EXECUTOR=YourExecutorName

ADMIN_USERNAME=admin
# Use a unique password with at least 12 characters.
ADMIN_PASSWORD=replace-with-a-unique-password
# Generate with: openssl rand -hex 32 (at least 32 characters).
AUTH_SESSION_SECRET=replace-with-a-random-secret-of-32-or-more-characters
